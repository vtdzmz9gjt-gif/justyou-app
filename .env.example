# Required — get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional — override the model. "claude-sonnet-5" is a rolling alias that
# always points at the current Sonnet model, which is the right choice for
# this app. Only pin a dated model ID (see https://docs.claude.com/en/docs/about-claude/models)
# if you specifically need to freeze behavior.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional — only needed if you want the "day before" proactive email nudge
# (see README: "Proactive check-ins"). Get a key at https://resend.com
RESEND_API_KEY=
FROM_EMAIL=The Return <onboarding@resend.dev>

# Optional — protects the /api/cron/check-ins endpoint from being called by
# anyone but your scheduler. Set this to any long random string, and pass the
# same value as a Bearer token when you configure the daily cron job.
CRON_SECRET=
