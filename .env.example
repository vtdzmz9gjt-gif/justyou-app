# Required — get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Required — Postgres connection string. On Vercel, this is set automatically
# once a Postgres database (e.g. Neon, from the Vercel Marketplace) is
# connected to the project. For local dev, run `vercel env pull` to copy it
# down, or point at any Postgres instance yourself.
DATABASE_URL=

# Optional — override the model. "claude-sonnet-5" is a rolling alias that
# always points at the current Sonnet model, which is the right choice for
# this app. Only pin a dated model ID (see https://docs.claude.com/en/docs/about-claude/models)
# if you specifically need to freeze behavior.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional — only needed if you want the "day before" proactive email nudge
# (see README: "Proactive check-ins"). Get a key at https://resend.com
RESEND_API_KEY=
FROM_EMAIL=The Return <onboarding@resend.dev>

# Optional — protects the /api/cron/check-ins and /api/cron/health-check
# endpoints from being called by anyone but your scheduler. Set this to any
# long random string, and pass the same value as a Bearer token when you
# configure the cron jobs.
CRON_SECRET=

# Optional — error monitoring for /api/chat (and anywhere else Sentry.init
# runs). Get one from a free-tier Sentry project's Client Keys (DSN) page.
# Without this set, Sentry.init() is a harmless no-op -- nothing breaks,
# nothing gets reported.
SENTRY_DSN=

# Optional — only needed if you want source maps uploaded to Sentry during
# build (readable stack traces in the Sentry UI instead of minified code).
# Skipped gracefully if unset.
SENTRY_ORG=
SENTRY_PROJECT=
